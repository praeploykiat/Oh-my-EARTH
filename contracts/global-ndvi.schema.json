{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "variable",
    "unit",
    "period",
    "retrievedAt",
    "qaPolicy",
    "taskId",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "MOD13A3.061"
    },
    "variable": {
      "const": "NDVI"
    },
    "unit": {
      "const": "1"
    },
    "qaPolicy": {
      "const": "good-land-clear-v1"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "retrievedAt": {
      "type": "string",
      "minLength": 20
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "const": 2001
        },
        "end": {
          "const": 2024
        }
      }
    },
    "records": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "requested",
          "values",
          "missing",
          "rejected"
        ],
        "properties": {
          "requested": {
            "type": "object",
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          },
          "values": {
            "type": "array",
            "minItems": 288,
            "maxItems": 288,
            "items": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -0.2000001,
              "maximum": 1
            }
          },
          "missing": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
            }
          },
          "rejected": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
            }
          }
        }
      }
    }
  }
}
