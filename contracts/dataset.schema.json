{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset.schema.json",
  "title": "Dataset",
  "type": "object",
  "required": ["id", "variable", "unit", "source", "region", "resolution", "series", "trend"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "variable": {
      "type": "object",
      "required": ["key", "label"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "unit": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["provider", "product"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "product": { "type": "string" },
        "url": { "type": "string" },
        "synthetic": { "type": "boolean" }
      }
    },
    "region": {
      "type": "object",
      "required": ["name", "lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "resolution": { "enum": ["monthly", "annual"] },
    "series": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["t", "value"],
        "additionalProperties": false,
        "properties": {
          "t": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?$" },
          "value": { "type": ["number", "null"] }
        }
      }
    },
    "trend": {
      "type": "object",
      "required": ["method", "slopePerDecade", "pValue", "significant", "alpha"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string" },
        "slopePerDecade": { "type": "number" },
        "pValue": { "type": "number", "minimum": 0, "maximum": 1 },
        "significant": { "type": "boolean" },
        "alpha": { "type": "number" }
      }
    }
  }
}
